# Build output
web/dist/*
!web/dist/.gitkeep
web/node_modules/
bin/

# Local state
*.db
*.db-wal
*.db-shm
# Tracked as an empty directory: Docker creates a missing bind-mount source as
# root, which the non-root app container then cannot write. Same idiom as
# web/dist above.
data/*
!data/.gitkeep

# Environment
.env
.env.local

# Editor
.idea/
.vscode/
*.swp

# Playwright output
.claude/e2e/test-results/
.claude/e2e/node_modules/

# Subagent-driven development scratch: ledgers, task briefs and review packages
.superpowers/
