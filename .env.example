# 32 raw bytes, base64-encoded. Generate with:
#   docker compose run --rm --no-deps app sh -c 'head -c 32 /dev/urandom | base64'
WD_SECRET_KEY=

# IANA timezone name. Decides where the day boundary falls for time entries.
WD_TIMEZONE=Europe/Amsterdam

# Optional; the server falls back to these defaults. docker-compose.yml sets both
# explicitly for the container, so they only take effect when the binary runs
# outside Compose.
#WD_ADDR=:8080
#WD_DB_PATH=/data/work-dashboard.db

# Read by docker-compose.yml, not by the server: the host port the dashboard is
# published on.
WD_PORT=8080
