# 32 raw bytes, base64-encoded. Generate with:
#   docker compose run --rm --no-deps app sh -c 'head -c 32 /dev/urandom | base64'
THAT_SECRET_KEY=

# IANA timezone name. Decides where the day boundary falls for time entries.
THAT_TIMEZONE=Europe/Amsterdam

# Optional; the server falls back to these defaults. docker-compose.yml sets both
# explicitly for the container, so they only take effect when the binary runs
# outside Compose.
#THAT_ADDR=:8080
#THAT_DB_PATH=/data/thatapp.db

# Read by docker-compose.yml, not by the server: the host port the dashboard is
# published on, bound to 127.0.0.1 only (there is no login).
THAT_PORT=8080

# Read by docker-compose.yml, not by the server: the UID/GID the dev containers
# run as, so the database in ./data and anything written into the working tree
# belong to you rather than to root.
#
# `make` fills these in from `id -u`/`id -g`, so every make target works without
# them. Set them here only if you drive Compose directly, as CLAUDE.md's
# `docker compose run ...` examples do:
#
#   printf 'THAT_UID=%s\nWD_GID=%s\n' "$(id -u)" "$(id -g)" >> .env
#
# There is no default on purpose. Guessing wrong does not fail cleanly — it
# half-works, then dies with EACCES on a file a different UID created, which
# reads like a Go or npm bug rather than a configuration one.
#
# The database lives in ./data on the host precisely so `make down` cannot delete
# it. If you are upgrading from the old named-volume layout and hit a permission
# error, run `make down` once: the cache volumes it drops were created root-owned
# and do not become writable by themselves.
#THAT_UID=
#THAT_GID=
